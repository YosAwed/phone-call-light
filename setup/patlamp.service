[Unit]
Description=Patlamp HTTP GPIO Controller
After=network.target hostapd.service dnsmasq.service
Wants=hostapd.service dnsmasq.service

[Service]
Type=simple
# Replace <PI_USER> before installing this example, or override ExecStart/WorkingDirectory with systemctl edit.
ExecStart=/usr/bin/python3 /home/<PI_USER>/phone-call-light/scripts/patlamp-standalone.py
WorkingDirectory=/home/<PI_USER>/phone-call-light
Restart=always
RestartSec=3

# Field-tested setup:
#   relay IN  -> GPIO4 / BCM4 / physical pin 7
#   relay type -> active-high, so PATLAMP_ACTIVE_LOW=0
# If your relay turns on when the GPIO is low, set PATLAMP_ACTIVE_LOW=1 instead.
Environment=PATLAMP_GPIO=4
Environment=PATLAMP_ACTIVE_LOW=0
Environment=PATLAMP_PORT=80

[Install]
WantedBy=multi-user.target
